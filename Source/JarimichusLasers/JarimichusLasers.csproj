<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build for a given RimWorld version with:  dotnet build -c Release -p:RimWorldVersion=1.5
    Supported: 1.4, 1.5, 1.6 (default). Output goes to <repo>/<version>/Assemblies/JarimichusLasers.dll
  -->
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>JarimichusLasers</RootNamespace>
    <AssemblyName>JarimichusLasers</AssemblyName>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputPath>..\..\$(RimWorldVersion)\Assemblies\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.4'">
    <DefineConstants>$(DefineConstants);RW14</DefineConstants>
    <RimWorldRefVersion>1.4.3901</RimWorldRefVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.5'">
    <DefineConstants>$(DefineConstants);RW15</DefineConstants>
    <RimWorldRefVersion>1.5.4409</RimWorldRefVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <DefineConstants>$(DefineConstants);RW16</DefineConstants>
    <RimWorldRefVersion>1.6.4871</RimWorldRefVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Compile the pure logic straight into this assembly. -->
  <ItemGroup>
    <Compile Include="..\JarimichusLasers.Core\**\*.cs" Exclude="..\JarimichusLasers.Core\obj\**;..\JarimichusLasers.Core\bin\**" LinkBase="Core" />
    <Compile Remove="obj\**" />
  </ItemGroup>
</Project>
