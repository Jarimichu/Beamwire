<Project>
  <!-- Keep restore output separate per RimWorld version, so switching versions never mixes package assets. -->
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <BaseIntermediateOutputPath>obj\$(RimWorldVersion)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
