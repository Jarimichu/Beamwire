<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Shared base for every beam node. -->
  <ThingDef Name="Beamwire_NodeBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Beamwire.Building_BeamNode</thingClass>
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6, 0.3, 0.6)</volume>
      </shadowData>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
    </graphicData>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <size>(1,1)</size>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <designationCategory>Power</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Flammability>0.3</Flammability>
      <Mass>8</Mass>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <placeWorkers>
      <li>Beamwire.PlaceWorker_BeamPreview</li>
    </placeWorkers>
  </ThingDef>

  <!-- ===================== Emitter ===================== -->
  <ThingDef ParentName="Beamwire_NodeBase">
    <defName>Beamwire_Emitter</defName>
    <label>beam emitter</label>
    <description>Draws power from the grid it is connected to and fires it as a thin laser beam in the direction it faces. It only draws what the receivers downstream need, up to its throughput limit. It can be aimed in 45° steps.\n\nAnything standing in a powered beam gets burned.</description>
    <graphicData>
      <texPath>Beamwire/Things/Emitter_Base</texPath>
    </graphicData>
    <uiIconPath>Beamwire/Things/Emitter_Icon</uiIconPath>
    <costList>
      <Steel>60</Steel>
      <Silver>25</Silver>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>Beamwire_Optics</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Beamwire.CompPowerTrader_BeamEmitter</compClass>
        <basePowerConsumption>20</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(90,215,255,0)</glowColor>
      </li>
      <li Class="Beamwire.CompProperties_BeamNode">
        <kind>Emitter</kind>
        <throughputSteps>
          <li>250</li>
          <li>500</li>
          <li>1000</li>
          <li>2000</li>
          <li>4000</li>
        </throughputSteps>
        <defaultThroughputIndex>2</defaultThroughputIndex>
      </li>
      <li Class="Beamwire.CompProperties_OpticalDust"/>
    </comps>
    <modExtensions>
      <li Class="Beamwire.BeamNodeGraphicExtension">
        <node>Emitter</node>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ===================== Receiver ===================== -->
  <ThingDef ParentName="Beamwire_NodeBase">
    <defName>Beamwire_Receiver</defName>
    <label>beam receiver</label>
    <description>Catches laser beams from any direction and feeds the power into the grid it is connected to. It asks for exactly what that grid is short of, or for its full intake while any battery on the grid can still charge.</description>
    <graphicData>
      <texPath>Beamwire/Things/Receiver_Base</texPath>
    </graphicData>
    <uiIconPath>Beamwire/Things/Receiver_Icon</uiIconPath>
    <costList>
      <Steel>60</Steel>
      <Silver>25</Silver>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>Beamwire_Optics</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Beamwire.CompBeamReceiver</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Beamwire.CompProperties_BeamNode">
        <kind>Receiver</kind>
        <maxIntake>4000</maxIntake>
        <rotatable>false</rotatable>
      </li>
      <li Class="Beamwire.CompProperties_OpticalDust"/>
    </comps>
    <modExtensions>
      <li Class="Beamwire.BeamNodeGraphicExtension">
        <node>Receiver</node>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ===================== Mirror ===================== -->
  <ThingDef ParentName="Beamwire_NodeBase">
    <defName>Beamwire_Mirror</defName>
    <label>beam mirror</label>
    <description>A one-sided mirror that turns in 45° steps. A beam striking its face at an angle turns 90°, and one hitting it head-on bounces straight back. Beams that hit the armoured back are absorbed. Every bounce loses a little power.\n\nExplosions can knock it out of alignment.</description>
    <graphicData>
      <texPath>Beamwire/Things/Mirror_Base</texPath>
    </graphicData>
    <uiIconPath>Beamwire/Things/Mirror_Icon</uiIconPath>
    <costList>
      <Steel>30</Steel>
      <Silver>15</Silver>
    </costList>
    <statBases>
      <WorkToBuild>900</WorkToBuild>
    </statBases>
    <researchPrerequisites>
      <li>Beamwire_Optics</li>
    </researchPrerequisites>
    <comps>
      <li Class="Beamwire.CompProperties_BeamNode">
        <kind>Mirror</kind>
      </li>
      <li Class="Beamwire.CompProperties_OpticalDust"/>
    </comps>
    <modExtensions>
      <li Class="Beamwire.BeamNodeGraphicExtension">
        <node>Mirror</node>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ===================== Splitter ===================== -->
  <ThingDef ParentName="Beamwire_NodeBase">
    <defName>Beamwire_Splitter</defName>
    <label>beam splitter</label>
    <description>A glass beam-splitter cube with a half-silvered pane inside. Every beam that hits it passes straight through and also turns 90°, so one beam becomes two. Power is shared between the branches according to how much the receivers on each side need. It turns in 45° steps.</description>
    <graphicData>
      <texPath>Beamwire/Things/Splitter_Base</texPath>
    </graphicData>
    <uiIconPath>Beamwire/Things/Splitter_Icon</uiIconPath>
    <costList>
      <Steel>30</Steel>
      <Silver>30</Silver>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
    </statBases>
    <researchPrerequisites>
      <li>Beamwire_Splitting</li>
    </researchPrerequisites>
    <comps>
      <li Class="Beamwire.CompProperties_BeamNode">
        <kind>Splitter</kind>
      </li>
      <li Class="Beamwire.CompProperties_OpticalDust"/>
    </comps>
    <modExtensions>
      <li Class="Beamwire.BeamNodeGraphicExtension">
        <node>Splitter</node>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ===================== Relay ===================== -->
  <ThingDef ParentName="Beamwire_NodeBase">
    <defName>Beamwire_Relay</defName>
    <label>beam relay</label>
    <description>Collects beams from any direction and re-fires them as one coherent beam in the direction it faces (45° steps), with the beam's range fully restored. It runs off the beam itself and consumes a little of the power passing through, so it needs no conduit.</description>
    <graphicData>
      <texPath>Beamwire/Things/Relay_Base</texPath>
    </graphicData>
    <uiIconPath>Beamwire/Things/Relay_Icon</uiIconPath>
    <costList>
      <Steel>50</Steel>
      <Silver>25</Silver>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>Beamwire_CoherentRelays</li>
    </researchPrerequisites>
    <comps>
      <li Class="Beamwire.CompProperties_BeamNode">
        <kind>Relay</kind>
        <upkeep>30</upkeep>
      </li>
      <li Class="Beamwire.CompProperties_OpticalDust"/>
    </comps>
    <modExtensions>
      <li Class="Beamwire.BeamNodeGraphicExtension">
        <node>Relay</node>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ===================== Prism ===================== -->
  <ThingDef ParentName="Beamwire_NodeBase">
    <defName>Beamwire_Prism</defName>
    <label>beam prism</label>
    <description>A three-way crystal. Every beam that enters goes straight on and also turns 90° to both sides, so one beam can feed receivers on either side of it. Power is shared between the three branches according to demand. It works the same from every side, so it never needs aiming.</description>
    <graphicData>
      <texPath>Beamwire/Things/Prism_Base</texPath>
    </graphicData>
    <uiIconPath>Beamwire/Things/Prism_Icon</uiIconPath>
    <costList>
      <Steel>30</Steel>
      <Silver>40</Silver>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>1400</WorkToBuild>
    </statBases>
    <researchPrerequisites>
      <li>Beamwire_Splitting</li>
    </researchPrerequisites>
    <comps>
      <li Class="Beamwire.CompProperties_BeamNode">
        <kind>Prism</kind>
        <rotatable>false</rotatable>
      </li>
      <li Class="Beamwire.CompProperties_OpticalDust"/>
    </comps>
    <modExtensions>
      <li Class="Beamwire.BeamNodeGraphicExtension">
        <node>Prism</node>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ===================== Safety shutter ===================== -->
  <ThingDef ParentName="Beamwire_NodeBase">
    <defName>Beamwire_Shutter</defName>
    <label>beam safety shutter</label>
    <description>An iris gate for beams. While open, beams pass straight through it with no loss. On Auto, it snaps shut whenever a colonist, colony animal, prisoner or guest walks into the beam beyond it, and reopens once they are clear. Hostiles don't trigger it. It can also be set to stay open or stay closed.

Place it just past an emitter or mirror, on the stretch of beam you want to guard.</description>
    <graphicData>
      <texPath>Beamwire/Things/Shutter_Base</texPath>
    </graphicData>
    <uiIconPath>Beamwire/Things/Shutter_Icon</uiIconPath>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
    </statBases>
    <researchPrerequisites>
      <li>Beamwire_Safety</li>
    </researchPrerequisites>
    <comps>
      <li Class="Beamwire.CompProperties_BeamNode">
        <kind>Shutter</kind>
        <rotatable>false</rotatable>
      </li>
      <li Class="Beamwire.CompProperties_OpticalDust"/>
    </comps>
    <modExtensions>
      <li Class="Beamwire.BeamNodeGraphicExtension">
        <node>Shutter</node>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ===================== Capacitor ===================== -->
  <ThingDef ParentName="Beamwire_NodeBase">
    <defName>Beamwire_Capacitor</defName>
    <label>beam capacitor</label>
    <description>Stores energy in the beam network. Like a relay, it collects beams from any side except its output and fires one beam out of its facing, with the range restored. Spare beam power charges it, up to 600 Wd at 1,000 W. When the incoming beams can't cover demand, it makes up the difference from storage, and it keeps powering receivers when no beam reaches it at all.</description>
    <graphicData>
      <texPath>Beamwire/Things/Capacitor_Base</texPath>
    </graphicData>
    <uiIconPath>Beamwire/Things/Capacitor_Icon</uiIconPath>
    <costList>
      <Steel>80</Steel>
      <Silver>20</Silver>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>20</Mass>
    </statBases>
    <researchPrerequisites>
      <li>Beamwire_Capacitors</li>
    </researchPrerequisites>
    <comps>
      <li Class="Beamwire.CompProperties_BeamNode">
        <kind>Capacitor</kind>
        <capacity>600</capacity>
        <maxCharge>1000</maxCharge>
        <maxDischarge>1000</maxDischarge>
        <chargeEfficiency>0.85</chargeEfficiency>
      </li>
      <li Class="Beamwire.CompProperties_OpticalDust"/>
    </comps>
    <modExtensions>
      <li Class="Beamwire.BeamNodeGraphicExtension">
        <node>Capacitor</node>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ===================== Beam window (a wall beams pass through) ===================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>Beamwire_Window</defName>
    <label>beam window</label>
    <description>A wall with a thick glass channel. It keeps out people, gas and weather, holds up the roof and seals rooms like any wall, but power beams pass straight through it. Use it to bring beams into your base without leaving a door open. It joins up with walls, rock and other beam windows, so a row of them forms one long pane, in either direction. Built from stone, it takes on that stone's look so it blends into stone walls and smoothed rock; a button switches the look.</description>
    <thingClass>Beamwire.Building_BeamWindow</thingClass>
    <category>Building</category>
    <graphicData>
      <!-- A linked atlas, like vanilla walls: each window picks its tile from the walls and windows around it,
           so a window in a north-south wall shows a vertical glass channel, and windows side by side form
           one continuous pane. -->
      <texPath>Beamwire/Things/Window_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
    </graphicData>
    <drawerType>MapMeshOnly</drawerType>
    <uiIconPath>Beamwire/Things/Window_Icon</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <blockLight>false</blockLight>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <tickerType>Never</tickerType>
    <size>(1,1)</size>
    <designationCategory>Power</designationCategory>
    <stuffCategories>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>8</costStuffCount>
    <costList>
      <Silver>10</Silver>
    </costList>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <researchPrerequisites>
      <li>Beamwire_Optics</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="Beamwire.BeamTransparentExtension"/>
    </modExtensions>
  </ThingDef>

</Defs>
