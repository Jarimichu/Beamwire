<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Combat Extended: give every beam node (they share Beamwire_NodeBase) a Bulk value for carrying when minified. Beam burns are Heat damage,
       which CE resolves against heat armour. Needs an in-game check under CE. -->
  <Operation Class="JarimichusLasers.PatchOperationIfParts">
    <enabled><li>Beamwire</li></enabled>
    <operation Class="PatchOperationFindMod">
      <mods>
        <li>Combat Extended</li>
      </mods>
      <match Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@Name="Beamwire_NodeBase"]/statBases</xpath>
        <value>
          <Bulk>10</Bulk>
        </value>
      </match>
    </operation>
  </Operation>
</Patch>
